# Copia este archivo como .env y completa los valores reales.
# NUNCA pongas credenciales reales en este archivo: se sube al repositorio.

NODE_ENV=development
PORT=3000

# --- Base de datos ---
# Producción (Neon): una sola cadena de conexión. Si DATABASE_URL está definida,
# se usa ella y se ignoran las variables DB_* de abajo.
# DATABASE_URL=postgresql://usuario:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Local (PostgreSQL en tu PC)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=RAP
DB_USER=postgres
DB_PASSWORD=cambia_esto

# --- Google OAuth ---
GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_client_secret
# Local:      http://localhost:3000/api/auth/google/callback
# Producción: https://TU-BACKEND.onrender.com/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# --- Frontend ---
# Una sola URL (sin barra final). Local: http://localhost:5173
# Producción: la URL de Vercel, ej. https://tu-app.vercel.app
FRONTEND_URL=http://localhost:5173

# --- Sesión ---
# Usa una cadena larga y aleatoria en producción.
SESSION_SECRET=cambia_esto_por_un_valor_largo_y_aleatorio
