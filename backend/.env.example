# ---------- Variables para Render (producción) ----------
NODE_ENV=production
PORT=3000

# Cadena de conexión que te da Neon (Dashboard > Connection string).
# Debe verse algo así:
# postgresql://usuario:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# URL pública de tu backend en Render (sin barra final)
BACKEND_URL=https://tu-backend.onrender.com

# URL pública de tu frontend en Vercel (sin barra final).
# Puedes poner varias separadas por coma, por ejemplo la de producción
# y una de preview: https://tu-app.vercel.app,https://tu-app-git-main.vercel.app
FRONTEND_URL=https://tu-app.vercel.app

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SESSION_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio

# ---------- Variables solo para desarrollo local (pgAdmin/Postgres local) ----------
# Si defines DATABASE_URL, estas se ignoran.
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=RAP
# DB_USER=postgres
# DB_PASSWORD=
